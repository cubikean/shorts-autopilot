# Highlight selection and copywriting
LLM_PROVIDER=claude           # openai, gemini or claude (Claude Code CLI, uses your Claude plan)
# Claude model alias (sonnet, haiku, opus); empty = sonnet.
# (Keep comments on their own line: dotenv reads "KEY=  # note" as the value "# note".)
CLAUDE_MODEL=
# Reasoning effort: low (default, fewest tokens), medium or high.
CLAUDE_EFFORT=
# Extended thinking: off (default, ~35% fewer tokens) or on
CLAUDE_THINKING=off
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# auto = detect the spoken language, then pick the model from LOCAL_WHISPER_MODELS
# ("lang=model" pairs, "*" = every other language). Any other value forces one model.
LOCAL_WHISPER_MODEL=auto
# English gains most from large-v3; other languages get the 3x faster turbo at near-equal accuracy.
# CPU only? large-v3 is slower than realtime there — use *=large-v3-turbo.
LOCAL_WHISPER_MODELS=en=large-v3,*=large-v3-turbo
# auto uses the NVIDIA GPU when available (CUDA libraries come with requirements.txt), else CPU
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
# Burned-in word-by-word captions (disable with --no-subtitles).
# Vertical position as a fraction of the height: 0 = top, 1 = bottom.
SUBTITLE_FONT=Arial Black
SUBTITLE_POSITION=0.70

# Daily feed (feed.py) — see README "Daily feed"
# Notion internal integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=
# Filled in from the output of: python feed.py setup-notion <page URL>
NOTION_VIDEOS_DB=
NOTION_SHORTS_DB=
# Twitch app credentials (https://dev.twitch.tv/console/apps); leave empty to skip Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FEED_SOURCES_FILE=sources.json
FEED_MIN_AGE_HOURS=2
FEED_MAX_AGE_HOURS=72
# YouTube source length limits (Twitch only downloads a window around each moment)
FEED_MIN_DURATION_MINUTES=1
FEED_MAX_DURATION_MINUTES=120
# YouTube: queue videos taking off this many times faster than the channel's usual pace.
# 0 = queue every new video from the listed channels (score then only orders the queue).
FEED_MIN_SCORE=1.5
FEED_TWITCH_MOMENTS_PER_CHANNEL=3
FEED_TWITCH_MIN_VIEWS=50
# Videos rendered per nightly run, and shorts per YouTube video
FEED_MAX_PER_RUN=3
FEED_CLIPS_PER_VIDEO=3

# Publishing (feed.py publish) — see README "Publishing"
# Comma-separated platforms to publish validated shorts to: youtube, tiktok
PUBLISH_PLATFORMS=youtube
# Shorts uploaded per run (YouTube's default quota is ~6 uploads/day)
PUBLISH_MAX_PER_RUN=1
# OAuth client JSON (Desktop app) from Google Cloud Console, and the token written by: python feed.py auth-youtube
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# public, unlisted or private (a "Date de publication" in the future schedules the release instead)
YOUTUBE_PRIVACY=public
# 24 Entertainment, 20 Gaming, 23 Comedy
YOUTUBE_CATEGORY_ID=24
# Minimum minutes between two shorts going public; extra uploads are scheduled for later
YOUTUBE_MIN_GAP_MINUTES=180

# TikTok drafts — sandbox app on https://developers.tiktok.com (see README "TikTok")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# The app's Desktop redirect URI must be http://127.0.0.1:<this port>/callback/
TIKTOK_REDIRECT_PORT=8765
# Your @handle, used for the link written in Notion
TIKTOK_USERNAME=
TIKTOK_TOKEN_FILE=tiktok_token.json

# Phone notifications via the ntfy app (https://ntfy.sh): the TikTok caption to paste, with a copy button.
# Topics need no sign-up: pick a long random name (anyone who knows it can read the notifications),
# e.g. python -c "import secrets; print('shorts-' + secrets.token_hex(8))", and subscribe to it in the app.
NTFY_TOPIC=
